    "stackablepotions": "*",
    "stackable_potions": "*",
    "stackable-potions": "*",
    "mr_stackable_totems": "*",
    "stackaletotems": "*",
    "stackable_totems": "*",
    "mr_stackable_item": "*",
    "stackabletools": "*",
    "sensible_stackables": "*",
    "mr_uiinpuis_stackablepearls":"*",
    "stack99": "*"
  },
  "accessWidener": "tweakmoremore.accesswidener"
