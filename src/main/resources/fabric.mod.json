{
  "schemaVersion": 1,
  "id": "tweakmoremore",
  "name": "tweakmoremore",
  "version": "${version}",
  "description": "tweaks to every extent of minecraft",
  "authors": ["winapiadmin"],
  "contact": {
    "homepage": "https://modrinth.com/mod/tweakmoremore/",
    "issues": "https://github.com/winapiadmin/tweakmoremore/issues",
    "sources": "https://github.com/winapiadmin/tweakmoremore"
  },
  "license": "All-Rights-Reserved",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "net.winapiadmin.tweakmoremore.client.Client"
    ],
    "main": [
      "net.winapiadmin.tweakmoremore.Main"
    ]
  },
  "mixins": [
    "tweakmoremore.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
